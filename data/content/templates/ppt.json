{
  "$schema": "../../schemas/template.schema.json",
  "id": "ppt",
  "version": 1,
  "authors": ["Michael Coaguila"],
  "appsLanguages": ["es", "en"],
  "name": { "es": "PowerPoint", "en": "PowerPoint" },
  "icon": "slideshow",
  "category": "win",
  "processes": ["powerpnt.exe"],
  "shortcuts": [
    {
      "id": "p1",
      "name": { "es": "Presentar", "en": "Present" },
      "icon": "play_arrow",
      "category": "file",
      "action": { "type": "tap", "keys": ["f5"] }
    },
    {
      "id": "p2",
      "name": { "es": "Nueva diapo.", "en": "New slide" },
      "icon": "add_box",
      "category": "nav",
      "action": { "type": "tap", "keys": ["ctrl", "m"] }
    },
    {
      "id": "p3",
      "name": { "es": "Duplicar", "en": "Duplicate" },
      "icon": "content_copy",
      "category": "edit",
      "action": { "type": "tap", "keys": ["ctrl", "d"] }
    },
    {
      "id": "p4",
      "name": { "es": "Agrupar", "en": "Group" },
      "icon": "group_work",
      "category": "sel",
      "action": { "type": "tap", "keys": ["ctrl", "g"] }
    },
    {
      "id": "p5",
      "name": { "es": "Siguiente", "en": "Next" },
      "icon": "arrow_forward",
      "category": "nav",
      "action": { "type": "tap", "keys": ["right"] }
    },
    {
      "id": "p6",
      "name": { "es": "Terminar", "en": "End show" },
      "icon": "stop",
      "category": "win",
      "action": { "type": "tap", "keys": ["esc"] }
    }
  ]
}
