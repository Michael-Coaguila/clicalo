{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Michael-Coaguila/clicalo/main/data/schemas/global-hotkeys.schema.json",
  "title": "Clícalo global shortcut choices",
  "description": "The closed list of combinations for the optional global shortcut that shows or hides the panel (BUR-005, user decision D10, ADR-0028). The setting stores the id; the first entry is the one preselected. Ids are persisted in the user document: never rename or reuse one.",
  "type": "object",
  "required": ["catalogVersion", "criteria", "hotkeys"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "$ref": "common.schema.json#/$defs/schemaRef" },
    "catalogVersion": { "$ref": "common.schema.json#/$defs/catalogVersion" },
    "criteria": {
      "description": "Why these combinations and not others, in English; one rule per item.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hotkeys": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "keys"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "keys": { "$ref": "common.schema.json#/$defs/keyChord" }
        }
      }
    }
  }
}
