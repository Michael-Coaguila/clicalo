{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Michael-Coaguila/clicalo/main/data/schemas/design-system.schema.json",
  "title": "Clícalo design system (direction C)",
  "description": "The only measures of the interface, in device-independent pixels (D12): spacing scale, control heights, radii, icon boxes, strokes and the closed type scale. Generated by TokenGenerator as Clicalo.UI.Wpf.Theming.Generated.Space, ControlHeight, Radii, IconBox, Stroke, FocusRing and TextStyles.",
  "type": "object",
  "required": ["space", "controlHeights", "radii", "iconBoxes", "strokes", "typography"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "$ref": "common.schema.json#/$defs/schemaRef" },
    "$comment": { "type": "string" },
    "space": { "$ref": "#/$defs/lengths" },
    "controlHeights": {
      "$ref": "#/$defs/lengths",
      "required": ["small", "medium", "large"]
    },
    "radii": {
      "$ref": "#/$defs/lengths",
      "required": ["small", "medium", "large", "pill"]
    },
    "iconBoxes": {
      "$ref": "#/$defs/lengths",
      "required": ["badge", "small", "medium", "large"]
    },
    "strokes": {
      "$ref": "#/$defs/lengths",
      "required": ["line", "selected", "focusRing", "focusOffset"]
    },
    "typography": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "properties": { "$comment": { "type": "string" } },
      "additionalProperties": { "$ref": "#/$defs/textStyle" }
    }
  },
  "$defs": {
    "name": {
      "description": "A camelCase identifier, or a comment member starting with $.",
      "type": "string",
      "pattern": "^([a-z][A-Za-z0-9]*|\\$comment)$"
    },
    "length": { "type": "number", "minimum": 0 },
    "lengths": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "properties": { "$comment": { "type": "string" } },
      "additionalProperties": { "$ref": "#/$defs/length" }
    },
    "textStyle": {
      "type": "object",
      "required": ["family", "weight", "size", "lineHeight"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "description": "ui = Atkinson Hyperlegible (400, 700); keys = JetBrains Mono (500), only for key combinations.",
          "enum": ["ui", "keys"]
        },
        "weight": { "enum": [400, 500, 700] },
        "size": { "type": "number", "minimum": 11 },
        "lineHeight": { "type": "number", "minimum": 11 },
        "letterSpacing": { "description": "Extra space between letters, in em.", "type": "number", "minimum": 0, "maximum": 0.2 },
        "uppercase": { "type": "boolean" }
      }
    }
  }
}
