{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Michael-Coaguila/clicalo/main/data/schemas/combo-icons.schema.json",
  "title": "Clícalo combination to icon map",
  "description": "Icon suggested first for a combination, per language of the user's programs (EDI-005, CAT-005): in Spanish Office Ctrl+N is bold, in English Ctrl+B.",
  "type": "object",
  "required": ["catalogVersion", "appsLanguage", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "$ref": "common.schema.json#/$defs/schemaRef" },
    "catalogVersion": { "$ref": "common.schema.json#/$defs/catalogVersion" },
    "appsLanguage": { "$ref": "common.schema.json#/$defs/langCode" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keys", "icon"],
        "additionalProperties": false,
        "properties": {
          "keys": { "$ref": "common.schema.json#/$defs/keyChord" },
          "icon": { "$ref": "common.schema.json#/$defs/iconId" }
        }
      }
    }
  }
}
