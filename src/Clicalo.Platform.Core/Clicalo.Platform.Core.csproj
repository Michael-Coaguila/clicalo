<Project Sdk="Microsoft.NET.Sdk">
  <!-- AOT-safe core shared with Sentinel and Launcher: KeyLedger, InjectionGate, IPC contracts, Trust. -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Clicalo.Platform.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clicalo.Platform.IntegrationTests" />
  </ItemGroup>
</Project>
