<Project Sdk="Microsoft.NET.Sdk">
  <!-- Views, automation peers, windowing, pointer input, theming. The only WPF-aware layer. -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Clicalo.UI.Wpf</RootNamespace>
    <ClicaloGeneratorProfile>UiWpf</ClicaloGeneratorProfile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clicalo.Presentation\Clicalo.Presentation.csproj" />
    <ProjectReference Include="..\Clicalo.Application\Clicalo.Application.csproj" />
    <ProjectReference Include="..\Clicalo.Domain\Clicalo.Domain.csproj" />
    <ProjectReference Include="..\..\generators\Clicalo.Generators\Clicalo.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Label="Design tokens consumed by the token generator">
    <AdditionalFiles Include="$(RepoRoot)data\tokens\*.json" />
    <CompilerVisibleProperty Include="ClicaloGeneratorProfile" />
  </ItemGroup>
</Project>
