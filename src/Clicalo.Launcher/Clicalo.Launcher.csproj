<Project Sdk="Microsoft.NET.Sdk">
  <!-- System component launcher: verifies and starts the protected elevated copy (ADR-0009). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Clicalo.Launcher</AssemblyName>
    <RootNamespace>Clicalo.Launcher</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="Shipped runtimes (Directory.Build.props)">
    <RuntimeIdentifiers>$(ClicaloRuntimeIdentifiers)</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(ClicaloRuntimeIdentifier)' != ''">$(ClicaloRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clicalo.Platform.Core\Clicalo.Platform.Core.csproj" />
  </ItemGroup>
</Project>
