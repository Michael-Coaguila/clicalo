<Project Sdk="Microsoft.NET.Sdk">
  <!-- Clicalo product-rule analyzers (CLC0001...). Rules live in code so people and agents get the same error. -->
  <PropertyGroup>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Clicalo.Analyzers</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Label="Release tracking (RS2000-RS2008): every rule id is declared with its category and severity">
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clicalo.Generators.Tests" />
  </ItemGroup>
</Project>
