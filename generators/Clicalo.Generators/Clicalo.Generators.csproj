<Project Sdk="Microsoft.NET.Sdk">
  <!-- Source generators: i18n keys, design tokens, catalogs and timings. Data errors become compile errors. -->
  <PropertyGroup>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Clicalo.Generators</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Label="Shared math, compiled into the generator (a generator cannot load project references at run time)">
    <Compile Include="..\Clicalo.Design.Math\**\*.cs" Exclude="..\Clicalo.Design.Math\obj\**;..\Clicalo.Design.Math\bin\**" LinkBase="DesignMath" />
  </ItemGroup>
  <ItemGroup Label="Analyzer release tracking (RS2008): every CLCC, CLCI and CLCT diagnostic is listed">
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clicalo.Generators.Tests" />
    <!-- cl i18n-check runs exactly the validation of the generator (blueprint §8.5): it reuses its Roslyn-free core. -->
    <InternalsVisibleTo Include="Clicalo.DevCli" />
  </ItemGroup>
</Project>
