<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the spike laboratory (tools/SpikeLab): the script engine (steps, 20 of 20, «Repetir», «Siguiente»,
    verdicts), the automatic checks, the reports (JSON and Markdown) and the guarded lab injector. Headless: nothing
    here shows a window or injects input.
  -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Clicalo.Tools.SpikeLab.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpikeLab.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
