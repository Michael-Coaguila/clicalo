<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer utilities behind `cl`: i18n-check, i18n-import, trace, notes, anonymize-v1, states. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ClicaloPortableTfm)</TargetFramework>
    <RootNamespace>Clicalo.DevCli</RootNamespace>
  </PropertyGroup>
  <ItemGroup Label="i18n-check runs the generator's own Roslyn-free validation (blueprint §8.5)">
    <ProjectReference Include="..\..\generators\Clicalo.Generators\Clicalo.Generators.csproj" />
  </ItemGroup>
  <ItemGroup Label="i18n-check also parses the CLDR plural rules with the runtime parser">
    <ProjectReference Include="..\..\src\Clicalo.Application\Clicalo.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clicalo.DevCli.Tests" />
  </ItemGroup>
</Project>
