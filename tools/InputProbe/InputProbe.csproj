<Project Sdk="Microsoft.NET.Sdk">
  <!-- Instrumented raw Win32 window (no WPF) that records every input event it receives. Used by integration tests. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Clicalo.Tools.InputProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
</Project>
