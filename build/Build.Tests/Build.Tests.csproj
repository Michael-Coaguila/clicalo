<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the `cl` orchestrator: final lines, reports, parsers and version pins. -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloPortableTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>Clicalo.Build.Tests</AssemblyName>
    <RootNamespace>Clicalo.Build.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Build.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
