<Project Sdk="Microsoft.NET.Sdk">
  <!-- Use cases, stores and actors with fake ports. -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloPortableTfm)</TargetFramework>
    <RootNamespace>Clicalo.Application.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Clicalo.Application\Clicalo.Application.csproj" />
    <ProjectReference Include="..\Clicalo.TestKit\Clicalo.TestKit.csproj" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup Label="CsCheck generators of the domain model, shared with Clicalo.Domain.Tests (public API only)">
    <Compile Include="..\Clicalo.Domain.Tests\Generators\**\*.cs" Link="Generators\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
