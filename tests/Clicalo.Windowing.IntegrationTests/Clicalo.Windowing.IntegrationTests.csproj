<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Real windows on a real desktop (blueprint §10.1): non-activation of the surfaces with synthetic finger, pen and
    mouse (S1), UI Automation on non-activatable windows with FlaUI (S3), and foreground leases per origin (S4).
    Folders: Windowing/, Pointer/, Automation/ and Foreground/ (docs/testing/spikes/M1-ownership.md). Tests that need an
    interactive desktop carry [Trait("Requires", "Desktop")] and run with CLICALO_DESKTOP_TESTS=1 (cl desk).
  -->
  <PropertyGroup>
    <TargetFramework>$(ClicaloWindowsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Clicalo.Windowing.IntegrationTests</RootNamespace>
    <!-- Per-monitor DPI awareness v2 from the first instruction, as the product (§3.7, ACC-008). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Clicalo.UI.Wpf\Clicalo.UI.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Clicalo.Presentation\Clicalo.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Clicalo.Application\Clicalo.Application.csproj" />
    <ProjectReference Include="..\..\src\Clicalo.Domain\Clicalo.Domain.csproj" />
    <ProjectReference Include="..\..\src\Clicalo.Platform.Core\Clicalo.Platform.Core.csproj" />
    <ProjectReference Include="..\..\src\Clicalo.Platform.Windows\Clicalo.Platform.Windows.csproj" />
    <ProjectReference Include="..\Clicalo.TestKit\Clicalo.TestKit.csproj" />
    <ProjectReference Include="..\Clicalo.TestKit.Windows\Clicalo.TestKit.Windows.csproj" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Axe.Windows" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup Label="Own pointer layer (blueprint §8.3): WPF's stylus and touch stacks are off from the first instruction">
    <RuntimeHostConfigurationOption
      Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport"
      Value="true"
    />
  </ItemGroup>
</Project>
