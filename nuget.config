<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain policy (blueprint §5 and §12.2 T12). Every restore, in CI and locally, uses only this file:
  - a single source (nuget.org) with packageSourceMapping and no fallback folders;
  - signatureValidationMode=require: a package is accepted only when its nuget.org repository signature is
    trusted AND one of its nuget.org owners is listed below.
  A new dependency whose owners are not listed makes restore fail with NU3034. To add one, read the owners
  recorded in its signature (`dotnet nuget verify` on the .nupkg, detailed verbosity, prints them under
  "Owners"), append the most specific stable account to <owners> (keep the list sorted) and justify it in
  the pull request.
  The certificates are the ones nuget.org publishes in its service index (RepositorySignatures/5.0.0),
  obtained with `dotnet nuget trust source nuget.org`.
-->
<configuration>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <!-- NuGet.org Repository by Microsoft, 2018-04-10 to 2021-04-14 -->
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <!-- NuGet.org Repository by Microsoft, 2021-02-16 to 2024-05-15 -->
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <!-- NuGet.org Repository by Microsoft, 2024-02-23 to 2027-05-18 -->
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>adamralph;AnthonyLloyd;belav;caesay;CycloneDX;fgather;gregsdennis;Humanizer;jbevain;jetbrains;meziantou;Microsoft;Microsoft.Toolkit;mmanela;newtonsoft;Polly;RobertGiesecke;Roemer;serilog;simoncropp;xunit</owners>
    </repository>
  </trustedSigners>
</configuration>
