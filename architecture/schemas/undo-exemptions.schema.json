{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Michael-Coaguila/clicalo/architecture/schemas/undo-exemptions.schema.json",
  "title": "Clícalo undo exemptions",
  "description": "Document commands that do not record an undo entry, each justified (REG-07, rule R7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "requirement", "exemptions"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 10 },
    "requirement": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "scope", "justification"],
        "properties": {
          "command": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "scope": {
            "description": "always: every application of the command. descriptorNotUndoable: only for SettingDescriptor.Undoable = false.",
            "enum": ["always", "descriptorNotUndoable"]
          },
          "justification": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
