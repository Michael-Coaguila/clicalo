{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Michael-Coaguila/clicalo/architecture/schemas/banned-api-exceptions.schema.json",
  "title": "Clícalo banned-API exceptions",
  "description": "Files where an RS0030 suppression is allowed, with the banned APIs they need and why.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 10 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "apis", "justification", "blueprint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "paths": {
            "description": "Repository-relative globs under src/ ('*' within a segment, '**' across segments).",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^src/[A-Za-z0-9._/*-]+$" }
          },
          "apis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "justification": { "type": "string", "minLength": 20 },
          "blueprint": { "type": "string", "pattern": "^§" }
        }
      }
    }
  }
}
