* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary
*.zip binary
# TestKit snapshots (*.verified.*) must be byte-stable
*.verified.txt text eol=lf
*.verified.png binary
# NuGet writes lock files with CRLF on Windows; keep the checkout identical to avoid spurious diffs
**/packages.lock.json text eol=crlf
